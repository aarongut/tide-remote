TIDE_HOST=10.0.0.130
TIDE_PORT=5555
HOST=0.0.0.0
PORT=3000
# Docker: set to the Docker host's LAN IP so the bastion can reach it.
# Default loopback permits only connections from this host.
BIND_IP=10.0.0.54
REMOTE_PORT=3000
# Public-facing origin used by your LAN-only nginx virtual host:
APP_ORIGIN=https://tide-control.local.frat.tech
# Optional HTTP Basic authentication (set both together):
# REMOTE_USER=tide
# REMOTE_PASSWORD=choose-a-password
